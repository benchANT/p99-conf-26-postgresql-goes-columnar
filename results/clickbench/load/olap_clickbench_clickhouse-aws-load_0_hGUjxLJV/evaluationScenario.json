{
  "metadata": {
    "userId": "benchANT",
    "projectId": "olap",
    "batchId": "clickbench",
    "configurationId": "clickhouse-aws-load",
    "executions": 1,
    "executionCounter": 1,
    "keepDeployment": true
  },
  "resourceProvider": {
    "name": "EC2",
    "api": "EC2"
  },
  "dbaasProvider": {
    "name": "CLICKHOUSE",
    "api": "CLICKHOUSE"
  },
  "dbmsDeployment": {
    "dbmsType": "CLICKHOUSE",
    "operationType": "DBAAS",
    "version": "latest",
    "DBAAS": {
      "clickhouseInstance": {
        "provider": "aws",
        "region": "eu-central-1",
        "minReplicaMemoryGb": 16,
        "maxReplicaMemoryGb": 16,
        "numReplicas": 2,
        "password": "REDACTED",
        "clientConfiguration": {
          "maxConnections": 100,
          "timeout": 600
        }
      }
    }
  },
  "benchmarkDeployment": {
    "benchmarkNodes": {
      "numberOfNodes": 1,
      "resource": {
        "ec2Vm": {
          "regionName": "eu-central-1",
          "instanceType": "c6i.4xlarge",
          "architecture": "x86_64",
          "imageDistribution": "ubuntu",
          "imageVersion": "22.04",
          "volumeType": "GP2",
          "volumeSize": 250
        }
      }
    }
  },
  "benchmark": {
    "id": "clickbench",
    "distribution": "CLICKBENCH",
    "version": "benchant-olap-main",
    "clickBench": {
      "dbmsEndpoints": [
        "ri68xbz744.eu-central-1.aws.clickhouse.cloud"
      ],
      "workload": {
        "s3SchemaUri": "s3://benchant-olap-data/clickbench/clickhouse/schema.sql",
        "s3DataUri": "s3://benchant-olap-data/clickbench/hits.csv.gz",
        "workloadClass": "site.ycsb.workloads.OlapWorkload",
        "maxExecutionTime": 900,
        "threadCount": 1,
        "operationCount": 100000,
        "querySet": "CLICKBENCH",
        "queriesLowerBound": 1,
        "queriesUpperBound": 12,
        "queryList": [
          "query01",
          "query02",
          "query03",
          "query04",
          "query05",
          "query06",
          "query07",
          "query08",
          "query09",
          "query11"
        ],
        "querySelectionStrategy": "SEQUENTIAL",
        "debug": false
      }
    }
  }
}